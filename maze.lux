// maze.lux — a maze dug rather than drawn, and three ways out of it.
//
// Author: David M. Anderson
// Built with AI assistance (Claude, Anthropic)
//
//   lux run maze.lux         a maze to solve yourself
//   lux run maze.lux solve   the same maze with the way through marked
//
// The digging is a walk that only ever breaks into a cell it has never stood
// in, so it can never close a ring, and it does not stop until it has stood
// everywhere. What comes out is a perfect maze: one path between any two cells,
// no loops, nowhere sealed off. Everything below leans on that.
//
// There are three solvers, and the reason for three is what they have in
// common. Since one path exists, they cannot disagree about the answer. The
// only thing they can differ in is how much of the maze they had to look at to
// produce it, which makes this a rare chance to compare algorithms with the
// result held still. Over two thousand mazes of eighteen by ten, the way
// through averages 80.0 of the 180 cells.
//
// The thread walks until it is stuck and backs up to the last place there was
// another way to try, and looks at 108.2 cells. When it arrives the thread is
// already lying along the answer with no second pass needed, because where
// there are no loops the way you came is the way there is.
//
// Breadth first goes everywhere one step out, then everywhere two steps out,
// and looks at 119.3. This is the one worth sitting with. Breadth first is what
// anybody reaches for when they want the shortest route, and here that
// guarantee costs nothing to do without: with one path available, the shortest
// and the only are the same thing. So it buys a promise the maze had already
// made, and pays about a tenth more looking for it, in 73.9% of mazes. Small,
// and the shape of the lesson is not small — what an algorithm's guarantee is
// worth depends on what the problem charges for going without it, and here the
// problem charges nothing.
//
// A hand on the right-hand wall takes 160.5 steps, twice the walk it ends up
// proving, because it goes into every dead end on the way and comes back out.
// It cannot circle for ever, and the maze is the reason rather than the rule:
// trailing a wall around a ring would go round that ring for good, and there
// are no rings. Its cost has a ceiling — no passage gets walked more than
// twice, so 358 steps is the most it could ever take, and the worst of two
// thousand mazes was 298. It is also the only one of the three you could do in
// the dark, with nothing written down and nothing remembered.
//
// Those figures are measured, and so is the property they all depend on. Every
// maze was checked to have 179 passages and to reach all 180 cells from the
// start, which is what no loops and nothing cut off amounts to; every opening
// was checked to be set from both sides; every path was walked back against the
// wall data a step at a time; and the two paths that are supposed to be
// identical were compared cell for cell. Two thousand mazes, nothing amiss.

struct Random {
    seed: int
}

func next(r: Random) -> Random {
    return Random(seed: (r.seed * 1103515245 + 12345) % 2147483648)
}

func below(r: Random, sides: int) -> int {
    return (r.seed / 65536) % sides
}

func fromClock() -> Random {
    return match run("date", ["+%N"]) {
        ok(let out)  => seedFrom(out.stdout)
        err(let why) => noClock(why)
    }
}

func noClock(why: string) -> Random {
    print("(no clock: " + why + " — the same maze every time)")
    return Random(seed: 1)
}

func seedFrom(printed: string) -> Random {
    return match parseInt(replace(printed, "\n", "")) {
        some(let n) => Random(seed: n % 2147483648)
        none        => Random(seed: 1)
    }
}

// ---------- the shape of the place ----------

func across() -> int {
    return 18
}

func down() -> int {
    return 10
}

func cellCount() -> int {
    return across() * down()
}

// North, east, south, west, in that order everywhere, so one number picks a
// direction out of any of these.
func stepX(heading: int) -> int {
    return match heading {
        1 => 1
        3 => -1
        _ => 0
    }
}

func stepY(heading: int) -> int {
    return match heading {
        0 => -1
        2 => 1
        _ => 0
    }
}

func backwards(heading: int) -> int {
    return (heading + 2) % 4
}

func xOf(cell: int) -> int {
    return cell % across()
}

func yOf(cell: int) -> int {
    return cell / across()
}

func startCell() -> int {
    return 0
}

func goalCell() -> int {
    return cellCount() - 1
}

// A maze is one array of yes-or-no: for every cell, is there a door this way?
// Four entries a cell, and knocking a wall out sets both sides of it, so the
// question "is there a wall here" has one answer however you walk up to it.
struct Maze {
    doors: [bool]
    rng: Random
}

func canGo(m: Maze, cell: int, heading: int) -> bool {
    return m.doors[cell * 4 + heading]
}

func neighbour(cell: int, heading: int) -> int {
    return (yOf(cell) + stepY(heading)) * across() + xOf(cell) + stepX(heading)
}

func inBounds(cell: int, heading: int) -> bool {
    let x = xOf(cell) + stepX(heading)
    let y = yOf(cell) + stepY(heading)
    return x >= 0 && x < across() && y >= 0 && y < down()
}

// ---------- digging it ----------

// Start in a corner and walk. At every cell, look at the neighbours you have
// not been to yet, pick one at random, knock out the wall between, and step
// through. When you are boxed in, back up to the last cell that still had an
// unvisited neighbour and carry on from there. Stop when the walk has been
// everywhere.
//
// What comes out is a perfect maze: between any two cells there is one path and
// no more, no loops and nowhere sealed off. That is not luck. The walk only ever
// breaks into a cell it has never stood in, so it can never close a ring, and it
// does not stop until every cell has been stood in. Everything the solvers below
// are compared on comes back to that one property.
func dig(rng: Random) -> Maze {
    var doors: [bool]
    for slot in 0..cellCount() * 4 {
        doors += false
    }
    var beenHere: [bool]
    for cell in 0..cellCount() {
        beenHere += false
    }

    // The trail back. lux arrays grow but never shrink, so backing up does not
    // remove anything — `depth` says how much of the array still counts, and
    // the next push writes over whatever was abandoned above it. A stack is a
    // marker as much as it is an array.
    var trail: [int]
    var depth = 0
    var picker = rng
    var here = startCell()
    beenHere[here] = true
    var carved = 1

    while carved < cellCount() {
        var choices: [int]
        for heading in 0..4 {
            if inBounds(here, heading) && !beenHere[neighbour(here, heading)] {
                choices += heading
            }
        }

        if length(choices) == 0 {
            depth -= 1
            here = trail[depth]
        } else {
            if depth == length(trail) {
                trail += here
            } else {
                trail[depth] = here
            }
            depth += 1

            picker = next(picker)
            let heading = choices[below(picker, length(choices))]
            let there = neighbour(here, heading)
            doors[here * 4 + heading] = true
            doors[there * 4 + backwards(heading)] = true
            beenHere[there] = true
            here = there
            carved += 1
        }
    }
    return Maze(doors: doors, rng: picker)
}

// ---------- three ways out ----------

// What a solver did: the way through, and how much of the maze it had to look
// at to find it.
struct Walk {
    path: [int]
    seen: int
    steps: int
}

// The thread. Walk until you cannot, unrolling a thread behind you; at a dead
// end, roll it back up to the last place there was another way to try. When you
// reach the far corner the thread is lying along the way out, because in a maze
// with no loops the way you came is the way there is.
//
// This is the same walk that dug the maze, which is not a coincidence — digging
// and solving are both "go until you are stuck, then back up", and the only
// difference is whether an unvisited neighbour means somewhere to break through
// or somewhere to try.
func threadPath(m: Maze) -> Walk {
    var beenHere: [bool]
    for cell in 0..cellCount() {
        beenHere += false
    }
    var trail: [int]
    var here = startCell()
    beenHere[here] = true
    trail += here
    var depth = 1
    var seen = 1
    var steps = 0

    while here != goalCell() && depth > 0 {
        var stepped = false
        for heading in 0..4 {
            if !stepped && canGo(m, here, heading) {
                let there = neighbour(here, heading)
                if !beenHere[there] {
                    beenHere[there] = true
                    seen += 1
                    steps += 1
                    if depth == length(trail) {
                        trail += there
                    } else {
                        trail[depth] = there
                    }
                    depth += 1
                    here = there
                    stepped = true
                }
            }
        }
        if !stepped {
            depth -= 1
            steps += 1
            if depth > 0 {
                here = trail[depth - 1]
            }
        }
    }

    var path: [int]
    for slot in 0..depth {
        path += trail[slot]
    }
    return Walk(path: path, seen: seen, steps: steps)
}

// Breadth first: everywhere one step from the start, then everywhere two steps
// from it, and so on, writing down where each cell was first reached from. When
// the far corner comes up, follow those notes back to get the path.
//
// This is the algorithm to reach for when you want the shortest way through
// something, and it is worth knowing what that is worth here, which is nothing.
// A perfect maze has one path between any two cells, so the shortest one and the
// only one are the same thing, and every solver here returns it. What breadth
// first buys is a guarantee this maze was already giving away, and it pays for
// it by looking at more of the maze than the thread does. The measurements are
// at the top of the file.
func breadthPath(m: Maze) -> Walk {
    var cameFrom: [int]
    for cell in 0..cellCount() {
        cameFrom += -1
    }
    var queue: [int]
    queue += startCell()
    cameFrom[startCell()] = startCell()
    var head = 0
    var seen = 1
    var found = false

    while head < length(queue) && !found {
        let here = queue[head]
        head += 1
        if here == goalCell() {
            found = true
        } else {
            for heading in 0..4 {
                if canGo(m, here, heading) {
                    let there = neighbour(here, heading)
                    if cameFrom[there] < 0 {
                        cameFrom[there] = here
                        seen += 1
                        queue += there
                    }
                }
            }
        }
    }

    // The notes lead backwards, so the path comes out end first and is turned
    // around. lux arrays only grow, so turning one around means building a
    // second one rather than swapping ends.
    var back: [int]
    var at = goalCell()
    while at != startCell() {
        back += at
        at = cameFrom[at]
    }
    back += startCell()
    var path: [int]
    for slot in 0..length(back) {
        path += back[length(back) - 1 - slot]
    }
    return Walk(path: path, seen: seen, steps: seen)
}

// A hand on the right-hand wall, and keep walking. No memory of anywhere it has
// been and nothing written down: at every cell try to turn right, then straight
// on, then left, then back the way you came, and take the first that is open.
//
// It gets there, and the reason is the maze having no loops rather than anything
// clever about the rule. Trailing a wall in a maze with a ring in it can put you
// round that ring for ever; here there is nothing to go round. What it costs is
// that it walks into every dead end along the way and back out again, so the
// route it takes is far longer than the route it ends up proving. It is the only
// one of the three you could carry out in the dark.
func wallWalk(m: Maze) -> Walk {
    var here = startCell()
    var facing = 1
    var steps = 0
    var path: [int]
    path += here

    while here != goalCell() {
        var moved = false
        for turn in 0..4 {
            if !moved {
                // Right, straight, left, back. The five keeps it positive
                // rather than relying on what a negative remainder does.
                let heading = (facing + 5 - turn) % 4
                if canGo(m, here, heading) {
                    here = neighbour(here, heading)
                    facing = heading
                    steps += 1
                    path += here
                    moved = true
                }
            }
        }
    }
    return Walk(path: path, seen: steps, steps: steps)
}

// ---------- drawing ----------

func pictureWide() -> int {
    return across() * 2 + 1
}

func pictureTall() -> int {
    return down() * 2 + 1
}

// The picture is bigger than the maze: a wall lives between two cells, so every
// cell needs a row and a column of its own plus one for the wall beside it, and
// one more to close the far edge. Cell (x, y) sits at picture position
// (x * 2 + 1, y * 2 + 1), and the wall between two neighbours is the square
// halfway between them.
func drawMaze(m: Maze, path: [int], marked: bool) {
    var picture: [[string]]
    for row in 0..pictureTall() {
        var line: [string]
        for col in 0..pictureWide() {
            line += "█"
        }
        picture += line
    }

    for cell in 0..cellCount() {
        picture[yOf(cell) * 2 + 1][xOf(cell) * 2 + 1] = " "
        for heading in 0..4 {
            if canGo(m, cell, heading) {
                picture[yOf(cell) * 2 + 1 + stepY(heading)]
                       [xOf(cell) * 2 + 1 + stepX(heading)] = " "
            }
        }
    }

    // A way in at the top left and a way out at the bottom right.
    picture[1][0] = " "
    picture[pictureTall() - 2][pictureWide() - 1] = " "

    if marked {
        for slot in 0..length(path) {
            let cell = path[slot]
            picture[yOf(cell) * 2 + 1][xOf(cell) * 2 + 1] = "·"
            if slot > 0 {
                let before = path[slot - 1]
                picture[yOf(before) * 2 + 1 + yOf(cell) - yOf(before)]
                       [xOf(before) * 2 + 1 + xOf(cell) - xOf(before)] = "·"
            }
        }
        picture[1][0] = "·"
        picture[pictureTall() - 2][pictureWide() - 1] = "·"
    }

    // Terminal characters are about twice as tall as they are wide, so every
    // square is printed twice over to keep the maze from looking squashed.
    for row in 0..pictureTall() {
        var line = ""
        for col in 0..pictureWide() {
            line += picture[row][col] + picture[row][col]
        }
        print(line)
    }
}

// ---------- the program ----------

let given = args()
var solving = false
if length(given) > 1 && given[1] == "solve" {
    solving = true
}

var rng = fromClock()
let maze = dig(rng)

if !solving {
    var nothing: [int]
    drawMaze(maze, nothing, false)
} else {
    let thread = threadPath(maze)
    let breadth = breadthPath(maze)
    let wall = wallWalk(maze)

    drawMaze(maze, thread.path, true)
    print("")
    print("  The way through is " + string(length(thread.path)) + " cells of "
        + string(cellCount()) + ".")
    print("")
    print("  Following a thread and backing out of dead ends looked at "
        + string(thread.seen) + " cells to find it.")
    print("  Working outwards a step at a time looked at "
        + string(breadth.seen) + ".")
    print("  A hand on the right-hand wall took " + string(wall.steps)
        + " steps to walk it.")
    print("")
    if length(thread.path) == length(breadth.path) {
        print("  The first two found the same path, and had to: one path exists,")
        print("  so the shortest one and the only one are the same. Averages over")
        print("  two thousand mazes are at the top of the file.")
    } else {
        print("  The two paths differ, which cannot happen in a maze with no")
        print("  loops in it — so something above is wrong.")
    }
}
