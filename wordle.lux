func wordBank() -> [string] {
    var all: [string]
    for row in wordRows() {
        for piece in split(row, " ") {
            all += piece
        }
    }
    return all
}

func isWord(word: string, bank: [string]) -> bool {
    for spot in 0..length(bank) {
        if bank[spot] == word {
            return true
        }
    }
    return false
}

// ---------------------------------------------------------------------------
// The rule

// 0 — not in the word. 1 — in the word, somewhere else. 2 — right place.
//
// Two passes, and the order is the rule rather than an implementation detail.
// The first pass claims the letters that are already in the right place and
// marks them as spent. The second can then only point at what is left over,
// which is what stops a third E being found in a word that has two.
func scored(guess: [int], secret: [int]) -> [int] {
    var marks: [int]
    for spot in 0..length(guess) {
        marks += 0
    }
    var spent: [bool]
    for spot in 0..length(secret) {
        spent += false
    }

    for spot in 0..length(guess) {
        if guess[spot] == secret[spot] {
            marks[spot] = 2
            spent[spot] = true
        }
    }

    for spot in 0..length(guess) {
        if marks[spot] == 0 {
            // lux has no `break`, so a flag stops the search after the first
            // unspent copy rather than walking on and spending more of them.
            var taken = false
            for other in 0..length(secret) {
                if !taken && !spent[other] && secret[other] == guess[spot] {
                    marks[spot] = 1
                    spent[other] = true
                    taken = true
                }
            }
        }
    }
    return marks
}

// The five marks packed into one number, base three. There are 243 of them, so
// a marking is itself an array index — which is what lets the solver below
// to sort a list of words into piles without holding the piles.
func keyOf(marks: [int]) -> int {
    var key = 0
    for spot in 0..length(marks) {
        key = key * 3 + marks[spot]
    }
    return key
}

func allRight(marks: [int]) -> bool {
    for spot in 0..length(marks) {
        if marks[spot] != 2 {
            return false
        }
    }
    return true
}

// ---------------------------------------------------------------------------
// Showing a guess

func shownGuess(guess: [int], marks: [int]) -> string {
    let big = capitals()
    var line = "  "
    for spot in 0..length(guess) {
        if marks[spot] == 2 {
            line += "[" + big[guess[spot]] + "]"
        } else if marks[spot] == 1 {
            line += "(" + big[guess[spot]] + ")"
        } else {
            line += " " + big[guess[spot]] + " "
        }
    }
    return line
}

func legend() -> string {
    return "  [A] right place    (A) in the word    A not in it"
}

// ---------------------------------------------------------------------------
// Narrowing
//
// Everything still possible after a guess: the words that would have produced
// exactly the marking that came back. That is the only thing the marking says,
// and it says all of it — no separate bookkeeping of which letters are in and
// which are out, because the marking already carries that.

func stillPossible(bank: [[int]], guess: [int], marks: [int]) -> [[int]] {
    let want = keyOf(marks)
    var left: [[int]]
    for spot in 0..length(bank) {
        if keyOf(scored(guess, bank[spot])) == want {
            left += bank[spot]
        }
    }
    return left
}

// Which of the words still possible splits the rest into the smallest worst
// pile. Scoring a candidate guess against every remaining word sorts them into
// at most 243 piles, one per marking; the pile you land in is the list you are
// left with, and the one to fear is the biggest. Choosing the guess whose
// biggest pile is smallest is choosing against the worst case rather than the
// average.
//
// It only ever guesses a word that could still be the answer, and the assumption
// that this is the weaker strategy turns out to be wrong. Playing every word in
// the list this way takes 3.351 guesses on average. Letting it spend a guess on
// a word already ruled out, chosen purely to split the survivors, takes 3.384 —
// thirty-six extra guesses across 1,107 words, or one word in thirty costing one
// more.
//
// What that buys is the other end. Guessing only from the survivors has a worst
// case of seven, and two words in the list reach it: `shave` and `wound`, each
// sitting in a crowd that differs by a single letter, where there is nothing to
// do but try them one at a time. Being allowed a throwaway guess caps the worst
// case at five and never needs a seventh.
//
// It stays with candidates anyway, for work rather than taste. Choosing from the
// whole list means scoring 1,107 words against every survivor on every move,
// which is quick built and minutes a move interpreted.
func bestGuess(left: [[int]]) -> int {
    var best = 0
    var bestWorst = -1
    for pick in 0..length(left) {
        var piles: [int]
        for k in 0..243 {
            piles += 0
        }
        for other in 0..length(left) {
            piles[keyOf(scored(left[pick], left[other]))] += 1
        }
        var worst = 0
        for k in 0..243 {
            if piles[k] > worst {
                worst = piles[k]
            }
        }
        if bestWorst < 0 || worst < bestWorst {
            bestWorst = worst
            best = pick
        }
    }
    return best
}

func wordFrom(marks: [int]) -> string {
    let small = alphabet()
    var out = ""
    for spot in 0..length(marks) {
        out += small[marks[spot]]
    }
    return out
}

// ---------------------------------------------------------------------------
// Reading what was typed

func lowered(text: string) -> string {
    let small = alphabet()
    let big = capitals()
    var out = text
    for slot in 0..length(big) {
        out = replace(out, big[slot], small[slot])
    }
    return out
}

// Where a given character sits in a piece of text — the same split trick as
// `lettersOf`, asked about one character instead of all twenty-six.
func spotsOf(text: string, mark: string) -> [int] {
    var out: [int]
    let pieces = split(text, mark)
    var at = 0
    for piece in 0..length(pieces) - 1 {
        at += length(pieces[piece])
        out += at
        at += 1
    }
    return out
}

// The marking typed back in solve mode: `g` for a letter in the right place,
// `y` for one in the word somewhere else, and anything else for one that is not
// in the word. An empty answer means it could not be read.
func marksFrom(text: string) -> [int] {
    var out: [int]
    let cleaned = replace(replace(text, " ", ""), "\t", "")
    if length(cleaned) != 5 {
        return out
    }
    for spot in 0..5 {
        out += 0
    }
    for at in spotsOf(cleaned, "g") {
        out[at] = 2
    }
    for at in spotsOf(cleaned, "y") {
        out[at] = 1
    }
    return out
}

// The word it opens with in solve mode, and the one worth opening with
// yourself. Measured rather than chosen — see the header.
func opener() -> string {
    return "arise"
}

func raised(text: string) -> string {
    let small = alphabet()
    let big = capitals()
    var out = text
    for slot in 0..length(small) {
        out = replace(out, small[slot], big[slot])
    }
    return out
}

// The letters no guess can use again, which is the part of the real game's
// keyboard that actually helps. A letter is ruled out only when it has been
// marked absent and never marked present anywhere.
func ruledOutLine(seen: [int]) -> string {
    let big = capitals()
    var out = ""
    for slot in 0..length(seen) {
        if seen[slot] == 1 {
            if out != "" {
                out += " "
            }
            out += big[slot]
        }
    }
    return out
}

// ---------------------------------------------------------------------------

let given = args()
let bank = wordBank()

var mode = "play"
var chosen = ""
if length(given) > 1 {
    if given[1] == "solve" {
        mode = "solve"
    } else {
        chosen = lowered(given[1])
    }
}

if mode == "solve" {
    print("Think of a five-letter word and do not tell me what it is.")
    print("")
    print("I will guess, and you mark each of my letters: `g` for one in the")
    print("right place, `y` for one in your word but somewhere else, and `.`")
    print("for one that is not in your word at all. So `.g..y` is five marks.")
    print("")

    var left: [[int]]
    for spot in 0..length(bank) {
        left += lettersOf(bank[spot])
    }
    print("I know " + string(length(left)) + " words.")
    print("")

    var tries = 0
    var solving = true
    while solving && tries < 8 {
        var guess = lettersOf(opener())
        if tries > 0 {
            guess = left[bestGuess(left)]
        }
        print("  guess " + string(tries + 1) + ": " + raised(wordFrom(guess)))
        let answer = input("  how did I do? ")

        if answer == "quit" || answer == "q" || answer == "" {
            print("  Stopping. I had " + string(length(left)) + " words left.")
            solving = false
        } else {
            let marks = marksFrom(answer)
            if length(marks) == 0 {
                print("  Five marks, one per letter — like `.g..y`.")
            } else if allRight(marks) {
                print("")
                print("  " + raised(wordFrom(guess)) + ", in "
                    + string(tries + 1) + ".")
                solving = false
            } else {
                left = stillPossible(left, guess, marks)
                tries += 1
                if length(left) == 0 {
                    print("")
                    print("  No word I know fits all of that, so one of the")
                    print("  markings must have been wrong. Nothing left to try.")
                    solving = false
                } else if length(left) == 1 {
                    print("  One word left.")
                } else {
                    print("  " + string(length(left)) + " words left.")
                }
            }
        }
    }
    if solving {
        print("  I have run out of guesses.")
    }
} else {
    var secret = chosen
    var mine = true
    if secret == "" {
        secret = bank[below(nextFrom(fromClock()), length(bank))]
    } else {
        mine = false
    }

    if length(secret) != 5 || !allLetters(lettersOf(secret)) {
        print("A word to guess has to be five letters. " + raised(secret)
            + " is not.")
    } else {
        let secretLetters = lettersOf(secret)
        print("Five letters, six guesses.")
        if !mine {
            print("(Somebody set this one. I will not say what it is.)")
        }
        print(legend())
        print("")

        // 0 not seen, 1 marked absent and never present, 2 present somewhere.
        var seen: [int]
        for slot in 0..26 {
            seen += 0
        }

        var tries = 0
        var won = false
        var playing = true
        while playing && !won && tries < 6 {
            let typed = lowered(input("guess " + string(tries + 1)
                + " of 6: "))
            if typed == "quit" || typed == "q" || typed == "" {
                playing = false
            } else if length(typed) != 5 {
                print("  Five letters. " + raised(typed) + " has "
                    + string(length(typed)) + ".")
            } else if !allLetters(lettersOf(typed)) {
                print("  Letters only.")
            } else if !isWord(typed, bank) {
                print("  I do not know " + raised(typed) + ".")
            } else {
                let guess = lettersOf(typed)
                let marks = scored(guess, secretLetters)
                tries += 1
                print(shownGuess(guess, marks))
                for spot in 0..length(guess) {
                    if marks[spot] == 0 {
                        if seen[guess[spot]] == 0 {
                            seen[guess[spot]] = 1
                        }
                    } else {
                        seen[guess[spot]] = 2
                    }
                }
                if allRight(marks) {
                    won = true
                } else {
                    let gone = ruledOutLine(seen)
                    if gone != "" {
                        print("      not in it: " + gone)
                    }
                }
            }
        }

        print("")
        if won {
            print("Got it in " + string(tries) + ".")
        } else if !playing {
            print("The word was " + raised(secret) + ".")
        } else {
            print("Out of guesses. The word was " + raised(secret) + ".")
        }
    }
}
