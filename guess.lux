// guess.lux — you think of a number and the computer finds it.
//
// Author: David M. Anderson
// Built with AI assistance (Claude, Anthropic)
//
//   lux run guess.lux
//   lux run guess.lux 1000000
//
// The guessing game everybody has played, turned around. You think of the
// number and say nothing; the program asks whether its guess is too high or too
// low, and it will have your number out of a hundred in seven questions and out
// of a million in twenty.
//
// Twenty questions for a million numbers is what the program is for, and it is
// not a trick. Each answer you give throws away half of what was left. A
// hundred numbers becomes fifty, then twenty-five, then thirteen, seven, four,
// two, one — seven questions, and it does not matter which number you picked or
// how cleverly you picked it. There is nowhere in the range that is harder to
// find than anywhere else, because the program never guesses at your number; it
// guesses at the middle of what it has not ruled out.
//
// That is called a binary search, and the reason it is worth meeting early is
// that the arithmetic runs the other way from how it feels. Doubling the range
// does not double the work — it adds one question. A thousand numbers takes ten,
// a million takes twenty, and the entire population of the earth takes
// thirty-three. Anything you can halve, you can search like this, and a great
// deal of what a computer does all day is finding a way to halve something.
//
// The program will also catch you moving your number, which it can do without
// suspecting anything: if the answers you give cannot all be true at once, the
// range it is holding runs out, and there is nothing left to guess.

// ---------- the generator, from random.lux ----------

// Only needed for the second half, when the guessing goes the usual way round
// and the program has to think of a number itself.
struct Random {
    seed: int
}

func next(r: Random) -> Random {
    return Random(seed: (r.seed * 1103515245 + 12345) % 2147483648)
}

func below(r: Random, sides: int) -> int {
    return (r.seed / 65536) % sides
}

func fromClock() -> Random {
    return match run("date", ["+%N"]) {
        ok(let out)  => seedFrom(out.stdout)
        err(let why) => noClock(why)
    }
}

func noClock(why: string) -> Random {
    print("(no clock: " + why + " — the same number every time)")
    return Random(seed: 1)
}

func seedFrom(printed: string) -> Random {
    return match parseInt(replace(printed, "\n", "")) {
        some(let n) => Random(seed: n % 2147483648)
        none        => Random(seed: 1)
    }
}

// ---------- how many questions this can possibly take ----------

// However many times the range has to be halved before one number is left, which
// is the same as asking how many times one has to be doubled to get past the
// range. There is no logarithm in lux and there does not need to be: counting
// the doublings is what a logarithm is.
//
// Past the range, not up to it, and the difference is a whole question. Ten
// doublings reach exactly 1024, but a range of 1024 takes eleven guesses, not
// ten — the last halving leaves two numbers and one of them still has to be
// asked about. Every exact power of two is wrong by one if you stop at `<`,
// which is a good reminder that a bound nobody has counted is a bound nobody
// has checked.
func questionsNeeded(span: int) -> int {
    var reach = 1
    var asked = 0
    while reach <= span {
        reach = reach * 2
        asked += 1
    }
    return asked
}

// The middle of what has not been ruled out — which is not the middle of the
// range, and is not a guess at your number at all. It is the question that rules
// out the most whichever way you answer it, and that is the only thing being
// aimed at. Being right occasionally is a side effect.
func middleOf(low: int, top: int) -> int {
    return low + (top - low) / 2
}

// ---------- reading answers ----------

func trimmed(typed: string) -> string {
    return replace(replace(typed, " ", ""), "\n", "")
}

// Comes back as "high", "low", "got it", "quit", or "" for anything else.
func verdict(typed: string) -> string {
    let plain = trimmed(typed)
    if plain == "" || plain == "q" || plain == "Q" || plain == "quit" {
        return "quit"
    }
    if plain == "h" || plain == "H" || plain == "high" || plain == "higher" {
        return "high"
    }
    if plain == "l" || plain == "L" || plain == "low" || plain == "lower" {
        return "low"
    }
    if plain == "c" || plain == "C" || plain == "correct" || plain == "y"
        || plain == "Y" || plain == "yes" {
        return "got it"
    }
    return ""
}

func numberTyped(typed: string) -> int {
    return match parseInt(trimmed(typed)) {
        some(let n) => n
        none        => -1
    }
}

// ---------- saying how much is left ----------

func lefts(count: int) -> string {
    if count == 1 {
        return "one number left"
    }
    return string(count) + " numbers left"
}

func halvingNote(before: int, after: int) -> string {
    if after == 1 {
        return "which leaves one, so that is the answer"
    }
    return "which throws away " + string(before - after) + " of them and leaves "
         + string(after)
}

// ---------- the range to play in ----------

func upperFrom(given: [string]) -> int {
    if length(given) < 2 {
        return 100
    }
    return match parseInt(given[1]) {
        some(let n) => sensible(n)
        none        => 100
    }
}

// A range of one has nothing to search and a range that runs past what the
// generator can reach cannot be picked from fairly, so both ends are pinned.
func sensible(n: int) -> int {
    if n < 2 {
        return 2
    }
    if n > 1000000000 {
        return 1000000000
    }
    return n
}

// ---------- the program guesses ----------

let high = upperFrom(args())
let worst = questionsNeeded(high)

print("Think of a whole number from 1 to " + string(high) + ". Do not tell me.")
print("")
print("After each guess, say whether the number you are thinking of is higher")
print("or lower: h for higher, l for lower, c when I have it. q to stop.")
print("")
print("It will take me at most " + string(worst) + " guesses, whatever you picked.")
print("")

var low = 1
var top = high
var asked = 0
var found = false
var giveUp = false
var cheated = false

while !found && !giveUp && !cheated {
    let span = top - low + 1
    let guessed = middleOf(low, top)
    asked += 1

    print("  Guess " + string(asked) + ": is it " + string(guessed) + "?   ("
        + lefts(span) + ")")
    let said = verdict(input("  h / l / c: "))

    if said == "quit" {
        giveUp = true
    } else if said == "got it" {
        found = true
    } else if said == "high" {
        let before = top - low + 1
        low = guessed + 1
        if low > top {
            cheated = true
        } else {
            print("  Higher, so nothing at " + string(guessed) + " or below can be it — "
                + halvingNote(before, top - low + 1) + ".")
        }
    } else if said == "low" {
        let before = top - low + 1
        top = guessed - 1
        if low > top {
            cheated = true
        } else {
            print("  Lower, so nothing at " + string(guessed) + " or above can be it — "
                + halvingNote(before, top - low + 1) + ".")
        }
    } else {
        asked -= 1
        print("  h if your number is higher than that, l if it is lower, c if I have it.")
    }
}

if cheated {
    print("")
    print("  That cannot be right. Every answer you have given rules something out,")
    print("  and between them they have ruled out every number there is — so there")
    print("  is nothing left for me to guess. Somewhere back there the number you")
    print("  were thinking of changed.")
} else if found {
    print("")
    print("  Found it in " + string(asked) + ".")
    if asked <= worst {
        print("  " + string(high) + " numbers, at most " + string(worst)
            + " questions, and it would have been the same if you had picked the worst one you could find.")
    }
}

// ---------- now the other way round ----------

if found {
    print("")
    let swap = trimmed(input("  Want to try it from my side? y/n: "))
    if swap == "y" || swap == "Y" || swap == "yes" {
        var rng = fromClock()
        rng = next(rng)
        let secret = 1 + below(rng, high)
        print("")
        print("  I am thinking of a number from 1 to " + string(high)
            + ". You have as many guesses as you like, but " + string(worst)
            + " is all it should take.")
        print("")

        var yourGuesses = 0
        var yourLow = 1
        var yourTop = high
        var solved = false
        var stopped = false

        while !solved && !stopped {
            let typed = input("  your guess: ")
            let tried = numberTyped(typed)
            if trimmed(typed) == "" || trimmed(typed) == "q" {
                stopped = true
                print("  It was " + string(secret) + ".")
            } else if tried < 1 || tried > high {
                print("  Between 1 and " + string(high) + ", please.")
            } else {
                yourGuesses += 1
                if tried == secret {
                    solved = true
                } else if tried < secret {
                    // Kept alongside so that the program can say at the end how
                    // much of its own advice you took: the best guess available
                    // was always the middle of what you had not ruled out.
                    if tried >= yourLow {
                        yourLow = tried + 1
                    }
                    print("  Higher. (" + lefts(yourTop - yourLow + 1) + ")")
                } else {
                    if tried <= yourTop {
                        yourTop = tried - 1
                    }
                    print("  Lower. (" + lefts(yourTop - yourLow + 1) + ")")
                }
            }
        }

        if solved {
            print("")
            print("  " + string(secret) + ", in " + string(yourGuesses) + ".")
            if yourGuesses < worst {
                print("  Faster than the halving, which means you were lucky rather than wrong — nothing can beat it on purpose.")
            } else if yourGuesses == worst {
                print("  Exactly the halving. There is no way to do better than that and be sure of it.")
            } else {
                print("  The halving would have needed at most " + string(worst)
                    + ". The way to get there is to guess the middle of what is left every time, never the number you have a feeling about.")
            }
        }
    }
}
